# ============================================================
# 个人记账本 - 环境变量模板
# 使用方法：复制为 backend/.env 后按实际环境修改
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，禁止提交到仓库
# ============================================================

# ---------- 应用 ----------
APP_NAME=个人记账本
DEBUG=false
# 访问 /docs 调试接口时可设为 true 打开 SQL 日志
LOG_LEVEL=INFO

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=994459
DB_NAME=ledger
DB_CHARSET=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- JWT ----------
# 生产环境务必替换为随机长字符串，例如：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=jd456fcdksiderv8654fghueaxcbgtyu
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ---------- 密码策略（后端强制校验） ----------
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=20

# ---------- 日志 ----------
# 日志目录：app.log 记录全部日志，error.log 只记录 ERROR 及以上
LOG_RETENTION_DAYS=7

# 启动时是否探测数据库连通性（自动化测试环境可设为 false）
STARTUP_DB_CHECK=true

# ---------- CORS ----------
# 多个来源用英文逗号分隔；* 表示放开全部（仅建议开发环境）
CORS_ORIGINS=*
